# Copy this file to .env and fill in the values from https://console.twilio.com
# These are read only by the API routes (server side), never bundled into the app.

# Console home page -> "Account Info"
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Console -> Verify -> Services -> Create new -> copy the "Service SID"
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
