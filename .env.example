# Copy this file to .env and fill it in. These values are read only by the
# API routes (server side) and are never bundled into the app.

# Which service sends the SMS: smsgate (default) or twilio
OTP_PROVIDER=smsgate

# --- SMS Gateway for Android (https://sms-gate.app) ---
# Install the app from https://github.com/capcom6/android-sms-gateway/releases,
# turn on "Cloud Server", tap "Start Service" -> Sign Up, then copy the
# username and password shown in the Cloud Server section.
SMSGATE_USERNAME=
SMSGATE_PASSWORD=

# Any long random string; used to sign OTP tokens
OTP_SECRET=change-me-to-a-long-random-string

# --- Twilio Verify (only when OTP_PROVIDER=twilio) ---
# Console home -> Account Info; Verify -> Services -> Service SID (VA...)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
